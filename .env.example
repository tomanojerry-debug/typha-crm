# 所有路径相对于项目根目录。数据库与凭据不得提交到 Git。
PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3100
DATA_DIR=.local/postgres
# AI 服务统一由系统配置，不提供用户端密钥或模型设置入口。
# 使用 MiniMax-M3.1-Flash；密钥仅保存在本机 .env 或部署环境，禁止提交 Git。
MINIMAX_API_KEY=
# cn 为中国大陆端点，global 为国际端点；按系统账号区域配置。
MINIMAX_API_REGION=cn
# 中国区固定域名：official（默认）使用 api.minimax.cn；compatible 使用 api.minimaxi.com。
# 仅影响 cn 账号，不切换地区，不接受自定义 URL；配置后重启服务生效。
MINIMAX_CN_ENDPOINT=official
# Private Graphiti worker; setup instructions: docs/knowledge.md
GRAPHITI_ENABLED=false
GRAPHITI_PYTHON=.local/graphiti-venv/bin/python
GRAPHITI_DATA_DIR=.local/graphiti
# 本机开发时直接进入指定账号的工作台，隐藏登录/退出入口；留空恢复密码登录。
# 仅支持开发环境、回环监听地址与本地 PGlite，不可用于公网或共享部署。
# LOCAL_ACCESS_EMAIL=admin@example.com
# 留空使用本地 PGlite。生产接入独立 PostgreSQL 后再进行部署验收。
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/light_crm
# NODE_ENV=production 时必须使用 HTTPS APP_ORIGIN；会话 Cookie 自动启用 Secure。
# 邮箱授权码加密：本地自动生成 .local/mail-encryption.key，请与数据库一起私密备份。
# 生产环境须设置 32 字节随机密钥的 base64 值；不配置时邮箱连接禁用。
# MAIL_ENCRYPTION_KEY=
# Mac / Windows 本机微信只读适配：仅 LOCAL_ACCESS_EMAIL 对应的当前用户可主动查询。
# CLI 需由本机用户安装及初始化；CRM 不自动提权或获取数据库密钥。
# 本机读取器使用 contacts/history --format json 命令约定。
# WECHAT_CLI_BIN=/absolute/path/to/wechat-cli
# 内置只读桥：WECHAT_CLI_BIN=/absolute/path/to/light_crm/scripts/wechat-bridge.py
# WECHAT_CLI_CONFIG=/absolute/path/to/light_crm/.local/wechat/config.json
# Windows可将 WECHAT_CLI_BIN 指向内置 wechat-bridge.py，同时配置绝对路径的Python解释器。
# WECHAT_PYTHON_BIN=C:\Python313\python.exe
# WECHAT_SQLCIPHER_BIN=C:\Tools\SQLCipher\sqlcipher.exe
# WECHAT_ZSTD_LIB=C:\Tools\Zstd\libzstd.dll
# WECHAT_HANDLE_BIN=C:\Tools\Sysinternals\handle64.exe
# Windows自定安装位置；exe文件名须为 Weixin.exe 或 WeChat.exe。
# WECHAT_APP_BIN=C:\Program Files\Tencent\Weixin\Weixin.exe
# 可选：仅统计此目录直属账号文件夹，不递归搜索磁盘。
# WECHAT_DATA_ROOT=C:\Users\example\Documents\xwechat_files
