          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "speaker_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "modality": {
            "type": "string",
            "enum": [
              "stated",
