{
  "name": "light-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "setup": "node --import tsx scripts/setup.ts",
    "wechat:check": "node --import tsx scripts/wechat-check.ts",
    "wechat:test": "node --import tsx scripts/wechat-test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json vite.config.ts vitest.config.ts index.html",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\" package.json tsconfig.json vite.config.ts vitest.config.ts index.html",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "start": "node --import tsx scripts/start.ts",
    "check": "npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.5.9",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.10.0",
    "nodemailer": "^10.1.7",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "saxes": "6.0.0",
    "yauzl": "3.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
